{
  "cleanUrls": false,
  "redirects": [
    { "source": "/privacy", "destination": "/privacy-policy.html", "permanent": false },
    { "source": "/elight-studio/privacy(.html)?", "destination": "/privacy-policy.html#elight-studio", "permanent": false },
    { "source": "/slomoly/privacy(.html)?", "destination": "/privacy-policy.html#slomoly", "permanent": false },
    { "source": "/rabese/privacy-en(.html)?", "destination": "/privacy-policy.html#rabese", "permanent": false },
    { "source": "/rabese/privacy(.html)?", "destination": "/privacy-policy-vi.html#rabese", "permanent": false }
  ],
  "rewrites": [
    { "source": "/:app(slomoly|rabese|elight-studio|maneki-dict|simple-reader)/:page(support|support-en|support-vi|terms|terms-en|terms-vi|index-vi)", "destination": "/:app/:page.html" },
    { "source": "/egg-island/:page(support|support-vi|terms|terms-vi|delete-data|delete-data-vi|index-vi)", "destination": "/egg-island/:page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
